GPTNL_DATALOADER="${HOME}/dataloader/gptnl_dataloader" # Path to the 'gptnl_dataloader' module in this repository
GPTNL_SCRATCH="${HOME}/dataloader/scratch" # Scratchpad directory
GPTNL_2_BASE="${HOME}/gpt-nl" # Base path to GPT-NL Epoch 2 curated dataset

GPTNL_1_CURATED="${GPTNL_2_BASE}/gpt_nl_dataset_v1.0" # Location of GPT-NL Epoch 1 curated datasets
GPTNL_1_TOKENIZED="${GPTNL_2_BASE}/gpt_nl_1.0_tokenized/" # Location of GPT-NL Epoch 1 tokenized output
GPTNL_1_BUCKETED="${GPTNL_2_BASE}/gpt_nl_dataset_v1.0_bucketed" # Location of GPT-NL Epoch 1 bucketed output
GPTNL_2_TOKENIZED="${GPTNL_2_BASE}/gpt_nl_dataset_v2.0_tokenized/" # Location of GPT-NL Epoch 2 tokenized output
GPTNL_2_BUCKETED="${GPTNL_2_BASE}/gpt_nl_dataset_v2.0_bucketed/" # Location of GPT-NL Epoch 2 bucketed output
GPTNL_DEBUG="${GPTNL_2_BASE}/debug_sets/" # Directory for debug output
GPTNL_CODE_PRECURATED="${GPTNL_2_BASE}/curated/cc_github_open_source/pipeline00000_github_open_source_63bf805_eval/stage1_data_splitting" # output directory of the open source data curation pipeline [https://github.com/GPT-NL/data-curation-pipeline/blob/7c9193510a9752517ec5aad6d7425d15788b7750/pipeline-configs/all_pass_config_template.yaml#L21]
GPTNL_CODE_POSTCURATED="${GPTNL_2_BASE}/gpt_nl_dataset_v1.0_bucketed/buckets_split_train/code" # GPT-NL Epoch 1 post curation code ouput
GPTNL_TOKENIZER="${GPTNL_2_BASE}/tokenizer/gpt-nl-128k-1.0/hf" # Path to GPT-NL tokenizer
